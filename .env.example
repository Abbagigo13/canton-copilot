# Copy this file to .env.local and fill in your key.
# The app runs WITHOUT a key: the chat falls back to built-in demo answers.

# Alibaba DashScope (OpenAI-compatible). Use the intl endpoint outside mainland China.
QWEN_API_KEY=sk-your-dashscope-key
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Budget guardrails for the 500k hackathon allowance
QWEN_TOKEN_LIMIT=500000
QWEN_TOKEN_RESERVE=5000
